1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.item-copy small{font-size:10px;color:#8b9aad}.status-btn{background:#e7f5ef;border:1px solid #cce8dd;border-radius:6px;color:#397b68;padding:5px 7px;font-size:10px}.status-btn:disabled{opacity:1}.icon-btn{border:0;background:transparent;color:#8d9bb0;font-size:17px}.icon-btn:hover{color:#d15b70}.diagram-demo .node-flow{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:center;padding:10px 3px 25px}.flow-segment{display:flex;align-items:center;gap:6px}.flow-node{display:flex;align-items:center;gap:6px;flex-wrap:wrap;background:#f2eeff;border:1px solid #d5cbf2;padding:12px;border-radius:10px;font-size:12px;font-weight:700;color:#54428b}.flow-node i{font-size:18px;font-style:normal;color:#8668c9}.node-arrow{font-size:17px;color:#a3a8c6}.metrics-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:9px;margin-bottom:13px}.metric{border-radius:10px;background:#f6f8fd;border:1px solid #dfe6f0;padding:13px;display:flex;flex-direction:column;gap:6px}.metric span{font-size:11px;color:#708097}.metric strong{font-size:28px;color:#2b4261}.micro-btn{margin-top:5px;width:40px;background:#e2e9f7;border:0;border-radius:5px;padding:4px;color:#3e6699;font-size:10px}.minor-btn{background:#f0f4fa;border:1px solid #d3e0ed;color:#4e6481;padding:8px 12px;border-radius:7px;font-size:12px;font-weight:600}.minor-btn:hover{background:#e0eaf9}.notes-demo{height:100%;min-height:110px;display:flex;flex-direction:column;gap:7px}.notes-demo textarea{resize:none;flex:1;min-height:100px;background:#fff8fc;border:1px solid #f1d6e3;padding:12px;border-radius:9px;font-size:13px;color:#573e56;line-height:1.6}.notes-demo small{color:#8b93a7;font-size:10px}.json-edit{display:flex;flex-direction:column;gap:8px;height:100%;min-height:130px}.json-edit textarea{resize:none;min-height:110px;flex:1;background:#1f2c40;border:1px solid #445675;border-radius:8px;color:#a5e7c9;padding:12px;font:11px/1.6 Consolas,monospace;tab-size:2}.json-edit .minor-btn{align-self:flex-start}.form-error{color:#ce3f54;font-size:11px}.empty-panel{height:100%;display:flex;flex-direction:column;gap:11px;align-items:center;justify-content:center;text-align:center;color:#657b9a;padding:13px;min-height:90px}.empty-glyph{font-size:36px;color:#adc2df}.empty-panel b{font-size:17px;color:#314564}.empty-panel p{font-size:12px;max-width:260px;margin:0;line-height:1.5}.primary-btn{border:1px solid #3a73bb;border-radius:8px;background:#356cae;color:white;padding:10px 15px;font-size:12px;font-weight:800;white-space:nowrap}.primary-btn:hover{background:#2c5e9c}.size-warning{position:sticky;bottom:0;left:0;z-index:3;padding:9px 12px;margin:7px;color:#8a4511;border-top:1px solid #f6ce89;background:#fff1cd;font-size:11px;line-height:1.4;font-weight:700}.resize-handle{position:absolute;right:1px;bottom:1px;width:24px;height:24px;background:#dceafa;border:0;border-radius:5px;color:#7294be;z-index:7;cursor:nwse-resize;font-size:17px;touch-action:none}.resize-handle:hover{background:#bdd7fa}.quick-picker{position:absolute;right:12px;top:47px;z-index:11;background:white;border-radius:11px;border:1px solid #b5c8e1;box-shadow:0 13px 30px #0c1e3a47;padding:7px;width:min(276px,calc(100% - 18px));max-height:calc(100% - 61px);overflow:auto}.picker-top{display:flex;align-items:center;justify-content:space-between;padding:5px 7px 9px;font-size:12px;color:#253b59}.picker-top button{background:transparent;border:0;font-size:17px;color:#71829a}.pick-option{display:flex;align-items:center;text-align:left;gap:9px;width:100%;padding:8px;border:0;border-radius:6px;background:transparent;color:#263852;font-size:12px}.pick-option:hover:not(:disabled){background:#eef5ff}.pick-option:disabled{opacity:.52}.pick-option>span:first-child{width:24px;text-align:center;font-size:17px}.pick-option>span:nth-child(2){display:flex;flex:1;flex-direction:column;min-width:0;gap:3px}.pick-option small{color:#71839e;font-size:10px}.pick-option>span:last-child{font-size:17px;color:#6383ae}.empty-workspace{position:absolute;left:50%;top:48%;transform:translate(-50%,-50%);width:420px;display:flex;align-items:center;flex-direction:column;text-align:center;padding:35px;border:1px dashed #395377;background:#121f34;border-radius:20px;color:#94a8c7}.empty-workspace>span{font-size:60px;color:#6f95ca}.empty-workspace h2{margin:5px 0 8px;font-size:22px;color:#e0edff}.empty-workspace p{line-height:1.6;font-size:12px;margin:0 0 22px}.status-footer{min-height:31px;display:flex;align-items:center;justify-content:space-between;gap:20px;background:#101b2d;border-top:1px solid #293851;padding:0 20px;color:#8195b0;font-size:10px}.status-footer strong{color:#a0b9dc}.modal-backdrop{position:fixed;inset:0;display:grid;place-items:center;background:#020a17b8;backdrop-filter:blur(4px);z-index:100;padding:24px}.catalog-dialog{height:min(760px,calc(100vh - 45px));width:min(1070px,calc(100vw - 40px));border:1px solid #435e85;background:#f9fbff;color:#1f324b;border-radius:18px;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 30px 90px #000a}.catalog-header{padding:24px 28px 19px;background:#eef4fc;display:flex;align-items:flex-start;justify-content:space-between;border-bottom:1px solid #d2ddec}.catalog-header h2{font-size:24px;letter-spacing:-.03em;margin:6px 0 6px;color:#1e334e}.catalog-header p{font-size:12px;color:#6c819a;margin:0}.close-modal{border:0;background:#e1eafa;width:35px;height:35px;border-radius:9px;color:#4f6486;font-size:25px}.catalog-main{flex:1;min-height:0;display:grid;grid-template-columns:265px 1fr}.catalog-list{min-height:0;overflow:auto;background:#f3f7fc;padding:12px;border-right:1px solid #d8e2f0}.catalog-entry{border:1px solid transparent;background:transparent;display:flex;align-items:center;width:100%;gap:13px;padding:12px 10px;border-radius:9px;text-align:left;color:#243750;margin-bottom:3px}.catalog-entry.chosen{background:#e3efff;border-color:#b6d3f7}.catalog-entry:hover{background:#e8f1fc}.catalog-icon{font-size:24px;width:30px;text-align:center}.catalog-entry b{font-size:12px}.catalog-entry small{font-size:10px;color:#71859f;display:block;margin-top:5px}.catalog-details{display:flex;flex-direction:column;min-height:0;padding:18px 22px 17px}.catalog-title{display:flex;justify-content:space-between;align-items:center;gap:12px}.catalog-title h3{margin:0;font-size:20px}.catalog-title p{font-size:11px;color:#8090a5;margin:7px 0 14px}.persisted-label{font-size:10px;font-weight:800;color:#288978;white-space:nowrap}.inspector-tabs{display:flex;gap:7px;border-bottom:1px solid #dae4f0;padding-bottom:10px}.inspector-tabs button{padding:7px 10px;border:0;border-radius:7px;font-size:12px;font-weight:700;color:#6b7e99;background:#f0f4f8}.inspector-tabs button.active{color:#235d9c;background:#dbeafd}.inspector-content{flex:1;min-height:0;overflow:auto;margin-top:15px;background:#fff;border:1px solid #dce5f0;border-radius:9px}.inspector-content .demo-content{min-height:auto;padding:20px}.state-pre{margin:0;padding:20px;min-height:100%;background:#162337;color:#c1f2e0;font:12px/1.75 Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}.catalog-actions{padding-top:14px;display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:11px;color:#8392a6}@container (max-width:420px){.metrics-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.demo-content{padding:11px}.collection-row{gap:6px;padding:7px}.diagram-demo .node-flow{justify-content:flex-start}.flow-node{padding:8px}}@container (max-width:275px){.metrics-grid{grid-template-columns:1fr}.event-entry{font-size:11px}.status-btn{font-size:9px;padding:4px}.remove-item{display:none}.flow-segment{max-width:100%}}@media(max-width:1150px){.brand{flex-basis:194px}.brand small{display:none}.top-header{gap:12px}.context-hint{display:none}.status-footer>div:last-child{display:none}}@media(max-width:800px){.top-header{padding:0 10px}.brand{flex-basis:170px}.brand strong{font-size:15px}.header-btn{padding:0 8px}.header-btn.highlighted{font-size:0}.header-btn.highlighted:before{content:"▦";font-size:21px}.context-bar{padding:8px 12px}.status-footer{font-size:9px}.catalog-main{grid-template-columns:170px 1fr}.catalog-entry{gap:7px;padding:9px 5px}.catalog-header{padding:15px}.catalog-details{padding:12px}}
.screen-tab-wrap{display:flex;align-items:center;position:relative;flex-shrink:0}.screen-tab-wrap .screen-tab{padding-right:29px}.screen-close{position:absolute;right:5px;top:7px;width:20px;height:22px;border:0;border-radius:5px;color:#8da6c7;background:transparent;font-size:16px;line-height:1}.screen-close:hover{background:#415579;color:#fff}

/* State and schema remain views of content data, not Workspace types. */
.state-editor{height:100%;display:flex;flex-direction:column;min-height:0}
.state-editor .json-edit{flex:1;min-height:180px;padding:13px;background:#f7faff}
.state-editor .json-edit textarea{font-size:12px;line-height:1.6}
.catalog-dialog{width:min(1140px,calc(100vw - 40px))}
.inspector-tabs{overflow-x:auto;flex-wrap:nowrap;min-height:47px;scrollbar-width:thin}
.inspector-tabs button{white-space:nowrap;flex-shrink:0}

/* Armed fit only changes the visual affordance; geometry changes on pointer release. */
.drag-grip{touch-action:none}
.panel-fit-button{flex:0 0 27px;width:27px;height:27px;border:1px solid #bdd0e6;border-radius:6px;background:#e7effa;color:#627fa9;font-size:18px;font-weight:700;padding:0}
.panel-fit-button:hover{background:#d5e7fd}
.panel-fit-button.active{background:#206d9f;color:white;border-color:#14547f;box-shadow:0 0 0 2px #74b5e866}
.window-panel.fit-armed{border-color:#398abe}
.window-panel.fit-armed .drag-grip{background:#e0f4ff;color:#246fa5}
.drag-ghost{position:fixed;z-index:75;pointer-events:none;display:flex;flex-direction:column;gap:5px;max-width:320px;transform:translate(3px,3px);padding:11px 14px;background:#142942ec;border:1px solid #8fbae7;color:#e9f4ff;border-radius:10px;box-shadow:0 10px 30px #0007}
.drag-ghost strong{font-size:13px}
.drag-ghost small{font-size:10px;color:#abc4e2}
.drag-ghost.fitting{background:#0b5363ed;border-color:#5cd0db}
.drag-notice{position:fixed;bottom:45px;left:50%;transform:translateX(-50%);z-index:65;border:1px solid #6492c2;background:#182d48;color:#f0f7ff;padding:9px 13px;border-radius:9px;box-shadow:0 6px 24px #0007;font-size:12px;max-width:75vw;display:flex;align-items:center;gap:16px}
.drag-notice button{border:0;background:transparent;color:#e7f1ff;font-size:20px;cursor:pointer}

/* Live window drag: its real contents follow the pointer; ordinary release commits this exact rectangle. */
.window-panel.dragging-live{pointer-events:none;border-color:#6aacf0;box-shadow:0 0 0 2px #438ed67a,0 25px 65px #000a;opacity:.96}
.window-panel.dragging-live .drag-grip{cursor:grabbing}
.window-panel.swap-target:after{content:"Обмен местами и размерами"}

/* Workspace settings belong to the far-right header, not the content canvas. */
.settings-trigger[aria-expanded="true"]{background:#32547d;border-color:#76adf1}
.settings-popover{position:absolute;top:64px;right:65px;width:min(336px,calc(100vw - 36px));border:1px solid #536e99;border-radius:12px;z-index:45;padding:16px;background:#152641;color:#ecf3ff;box-shadow:0 19px 60px #0009}
.settings-popover-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;font-size:14px}
.settings-close{width:25px;height:25px;border:0;background:#2b4161;border-radius:6px;color:#e5ecf9;font-size:18px}
.settings-field-label{display:block;font-size:12px;font-weight:800}
.settings-popover p{font-size:11px;color:#adbed8;line-height:1.5;margin:8px 0 15px}
.settings-input-row{display:flex;align-items:center;gap:9px;font-size:12px;color:#a7bee0}
.settings-input-row input[type="range"]{flex:1;min-width:0;accent-color:#91bbff;cursor:pointer}
.settings-number{width:53px;border:1px solid #587198;background:#243a5d;color:white;border-radius:7px;padding:7px 4px;text-align:center}
.settings-footer{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:14px;padding-top:12px;border-top:1px solid #344c6d;font-size:10px;color:#88a4c7}
.settings-footer button{border:0;background:transparent;color:#bdd8ff;font-size:11px;text-decoration:underline}
@media(max-width:930px){.settings-trigger{padding:0 11px}.settings-label{display:none}.settings-gear{font-size:20px}}
