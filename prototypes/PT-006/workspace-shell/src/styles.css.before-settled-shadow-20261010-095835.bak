:root{font-family:Inter,ui-sans-serif,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:#e5ecfa;background:#0b1424;font-synthesis:none;text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased}*{box-sizing:border-box}html,body,#root{height:100%;min-height:100%;margin:0}body{overflow:hidden}button,input,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed}button:focus-visible,input:focus-visible,textarea:focus-visible{outline:2px solid #7db4ff;outline-offset:2px}.app-shell{height:100vh;display:flex;flex-direction:column;min-width:740px;background:#0b1424}.top-header{height:74px;flex-shrink:0;background:#101c31;border-bottom:1px solid #293b57;display:flex;align-items:center;gap:25px;padding:0 23px;z-index:12;position:relative}.brand{display:flex;align-items:center;gap:12px;flex:0 0 250px;min-width:0}.brand-symbol{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;background:#273f65;border:1px solid #4d6c9f;font-size:24px;color:#97bdff}.brand strong{display:block;font-size:17px;color:#f3f7ff;letter-spacing:-.025em}.brand small{display:block;font-size:10px;margin-top:4px;color:#95a7c2;letter-spacing:.05em;text-transform:uppercase}.screen-tabs{display:flex;align-items:center;min-width:100px;gap:7px;flex:1;overflow-x:auto;scrollbar-width:thin;padding:7px 1px;white-space:nowrap}.screen-tab,.new-screen{height:36px;border:1px solid #324562;color:#aebed7;background:transparent;border-radius:8px;padding:0 14px;flex-shrink:0;font-size:12px;font-weight:600}.screen-tab:hover,.new-screen:hover{background:#233451;color:#edf4ff}.screen-tab.current{color:#e6f0ff;border-color:#5477ae;background:#223a60;box-shadow:inset 0 -2px #86b6ff}.new-screen{border-style:dashed}.header-actions{margin-left:auto;display:flex;align-items:center;gap:8px;flex-shrink:0}.header-btn{height:37px;background:#243651;border:1px solid #3e5273;border-radius:8px;color:#e4edfc;padding:0 14px;font-size:12px;font-weight:700;white-space:nowrap}.header-btn:hover{background:#304765}.header-btn.highlighted{background:#315b87;border-color:#4c89c9}.header-btn.subdued{font-size:21px;width:38px;padding:0}.context-bar{height:67px;padding:10px 25px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;gap:20px;border-bottom:1px solid #1d2e45;background:#111d30}.context-title{display:flex;align-items:center;gap:15px}.eyebrow{font-size:9px;font-weight:800;letter-spacing:.14em;color:#8eadd4}.rename-screen{background:transparent;border:0;color:#f5f8ff;font-size:20px;font-weight:720;letter-spacing:-.025em}.rename-screen span{color:#7596c1;font-size:13px}.context-title form input{background:#1d304d;color:white;border:1px solid #7b9dd2;border-radius:6px;padding:7px}.context-count{color:#8fa5c4;font-size:11px;border-left:1px solid #3b4d68;padding-left:16px}.context-hint{font-size:11px;color:#9faec6;white-space:nowrap}.status-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#71ddb5;margin-right:8px}.stage-scroll{background:#0d1829;flex:1;overflow:auto;position:relative;scrollbar-color:#415475 #0d1829;scrollbar-width:thin}.workspace-board{position:relative;min-height:100%;background-color:#0d1829;background-image:radial-gradient(circle at 2px 2px, #243650 1px, transparent 0);background-size:24px 24px}.window-panel{position:absolute;min-width:190px;min-height:156px;display:flex;flex-direction:column;background:#f9fbff;border:1px solid #526985;border-radius:12px;color:#1d2a41;box-shadow:0 13px 37px #01081277,0 2px 4px #0108124d;overflow:hidden;transition:box-shadow .1s,border-color .1s}.window-panel.selected{border-color:#94baf6;box-shadow:0 0 0 2px #628ac36e,0 18px 46px #010812aa}.window-panel.swap-target{border:2px dashed #69b2fa;box-shadow:0 0 0 6px #3e92ed33,0 15px 45px #0009}.window-panel.swap-target:after{content:"Обменять места и размеры";pointer-events:none;position:absolute;inset:51px 0 0;display:grid;place-items:center;background:#215087d9;color:white;font-size:16px;font-weight:800;z-index:14}.panel-header{display:flex;align-items:center;height:44px;flex:0 0 44px;border-bottom:1px solid #d6e1ed;background:#f1f5fb;gap:3px;overflow:hidden;padding:0 8px 0 7px}.drag-grip{display:flex;align-items:center;justify-content:center;gap:5px;flex-shrink:0;height:32px;border-radius:7px;padding:0 5px;cursor:grab;color:#55759e;user-select:none;font-size:17px}.drag-grip:active{cursor:grabbing}.drag-grip:hover{background:#d9e9fc}.panel-id{font-size:10px;font-weight:800;letter-spacing:.04em;color:#8095ac}.tab-strip{flex:1;display:flex;gap:2px;min-width:0;overflow-x:auto;scrollbar-width:none;height:38px;align-items:center}.tab-strip::-webkit-scrollbar{display:none}.content-tab{height:30px;display:flex;align-items:center;background:#e6edf7;border:1px solid #d8e2ef;border-radius:7px;flex:0 0 auto;max-width:180px}.content-tab.active{background:#fff;border-color:#acc5ea;box-shadow:inset 0 -2px #81b0ed}.content-tab>button{background:transparent;border:0;color:#33465f;height:100%;font-size:11px;padding:0 5px;min-width:0}.content-tab>button:first-child{display:flex;gap:5px;align-items:center}.content-tab .tab-label{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.content-tab .tab-x{color:#95a4bb;font-size:17px;padding:0 5px}.content-tab .tab-x:hover{color:#d14f59}.panel-header-action{width:26px;height:27px;padding:0;border:0;border-radius:6px;color:#4e6484;background:#e5edf8;font-size:19px;flex-shrink:0}.panel-header-action:hover{color:#193455;background:#cbdff7}.panel-body{position:relative;flex:1;overflow:auto;min-height:0;background:#fbfcff;container-type:inline-size;scrollbar-color:#b3c6e0 transparent}.edge-actions{position:sticky;left:calc(100% - 23px);bottom:12px;display:flex;flex-direction:column;width:25px;gap:2px;z-index:4;float:right;margin:-116px 4px 8px 0;background:#e5edfa;border:1px solid #d3e1f4;padding:3px;border-radius:8px}.edge-actions button{border:0;padding:0;height:24px;font-size:11px;background:transparent;border-radius: